# Mentora Frontend Environment Variables Template (IMP-027)
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit the actual .env file to version control.

# Backend API Base URL
# In development: http://localhost:4000/api/v1
# In production: https://<mentora-server>.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1
