# Mentora Backend Environment Variables Template (IMP-027)
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit the actual .env file to version control.

# Server Configuration
NODE_ENV=development
PORT=4000

# MongoDB Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mentora

# JSON Web Token Secret & Expiration
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=<replace-with-minimum-32-character-random-secret>
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Client Application)
# In development: http://localhost:5173
# In production: https://<mentora-client>.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API Configuration
GEMINI_API_KEY=<replace-with-google-ai-studio-api-key>
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.5-flash-lite

# Pedagogical Quota Configuration
DAILY_AI_QUOTA_LIMIT=50

# Reverse-proxy hops in front of the server (Express `trust proxy`).
# Guest quotas and rate limits are keyed by the client IP derived from this.
# 1 = one load balancer (default). If production logs show every request with the same
# proxy IP, increase it to the number of proxies the platform adds.
TRUST_PROXY=1

# Optional header that carries the real client IP, set by the edge in front of the app.
# When set and valid, it keys guest quotas and rate limits instead of the TRUST_PROXY-derived
# IP. On Render (behind Cloudflare) use cf-connecting-ip; leave empty for local development.
CLIENT_IP_HEADER=

# Set to true to log the proxy headers of the first 20 requests after start, to confirm
# TRUST_PROXY / CLIENT_IP_HEADER in production. Logs client IPs, so switch it off again.
LOG_CLIENT_IP_DIAGNOSTICS=false
