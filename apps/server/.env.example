# Mentora Backend Environment Variables Template (IMP-027)
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit the actual .env file to version control.

# Server Configuration
NODE_ENV=development
PORT=4000

# MongoDB Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mentora

# JSON Web Token Secret & Expiration
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=<replace-with-minimum-32-character-random-secret>
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Client Application)
# In development: http://localhost:5173
# In production: https://<mentora-client>.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API Configuration
GEMINI_API_KEY=<replace-with-google-ai-studio-api-key>
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.6-pro

# Pedagogical Quota Configuration
DAILY_AI_QUOTA_LIMIT=50
